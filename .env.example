# Copy to .env.local and fill in. Every variable here must also be wired
# through deploy.sh and .github/workflows/deploy.yml -- `pnpm check:env`
# (run in CI) fails if the three lists drift apart.

# Twilio Configuration -- Console > Account Info (SID, auth token);
# Verify > Services; Messaging > Services; Content Template Builder; Sync > Services
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid_here
TWILIO_MESSAGING_SERVICE_SID=your_twilio_messaging_service_sid_here
TWILIO_CONTENT_SID=your_approved_twilio_content_sid_here
SYNC_SERVICE_SID=your_twilio_sync_service_sid_here

# Admin Authentication (format: username:password) -- protects /admin, /stats, /api/admin/*
ADMIN_CREDENTIALS="username:password"

# Igloo Home API Credentials -- https://developer.igloocompany.co/ (API key list)
CLIENT_ID=your_igloo_client_id_here
CLIENT_SECRET=your_igloo_client_secret_here

# Optional: vault LED (kiosk mode) -- base URL of the vendor's Raspberry Pi,
# e.g. http://192.168.0.48. The app server calls /setGreen on a solve and
# /setRed when a new player starts, so the server needs a route to the Pi.
# Leave empty to disable. See utils/vaultLed.ts.
PI_BASE_URL=
